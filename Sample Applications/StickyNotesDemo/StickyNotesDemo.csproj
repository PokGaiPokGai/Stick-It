<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultItems>false</EnableDefaultItems>
    <RootNamespace>StickyNotesDemo</RootNamespace>
    <AssemblyName>Stick It</AssemblyName>
    <Product>Stick It</Product>
    <Title>Stick It</Title>
    <Version>0.4.0</Version>
    <ApplicationIcon>Assets/StickIt.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
    <Page Include="Assets/TaskStyles.xaml" />
    <Compile Include="App.cs;MainWindow.cs;Window2.cs;NoteStore.cs;SingleInstance.cs;DesktopIntegration.cs;MarkdownView.cs;MarkdownWriter.cs;NoteEditor.cs;NoteEditor.Blocks.cs;NoteLists.cs" />
    <Resource Include="Assets/StickIt.ico" />
    <None Include="Assets/StickIt.png" />
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>
</Project>
