<Window x:Class="StickyNotesDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Stick It" Width="478" Height="720" MinWidth="320" MinHeight="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Icon="Assets/StickIt.ico" FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#202020">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="7"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#858585"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EEEEEE"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#EAEAEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="SettingsHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#737373"/>
            <Setter Property="Margin" Value="2,22,0,9"/>
        </Style>
        <Style x:Key="SettingsSwitch" TargetType="CheckBox">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Padding="14" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ContentPresenter Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <Border x:Name="Track" Grid.Column="1" Width="40" Height="22" CornerRadius="11" VerticalAlignment="Center"
                                        Background="Transparent" BorderBrush="#929292" BorderThickness="1">
                                    <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0" Fill="#858585" HorizontalAlignment="Left"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#353535"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#353535"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F1F1F1"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#757575"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsAction" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#F6F6F6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#ECECEC"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E1E1E1"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#757575"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="White" BorderBrush="#A0A0A0" BorderThickness="1" CornerRadius="7">
        <Grid x:Name="LibrarySurface" Margin="1">
            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="DragTitle">
                <Button x:Name="NewNoteButton" Style="{StaticResource ChromeButton}" Content="&#xE710;" HorizontalAlignment="Left" ToolTip="新建便签（Shift + Alt + W）" Click="NewNoteClick"/>
                <Button x:Name="BackButton" Style="{StaticResource ChromeButton}" Content="&#xE72B;" HorizontalAlignment="Left" Visibility="Collapsed"
                        ToolTip="返回便签列表（Esc）" AutomationProperties.Name="返回便签列表" Click="BackClick"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SettingsButton" Style="{StaticResource ChromeButton}" Content="&#xE713;" ToolTip="设置" AutomationProperties.Name="设置" Click="SettingsClick"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" ToolTip="收起到托盘" AutomationProperties.Name="收起到托盘" Click="CloseClick"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="PageTitle" Grid.Row="1" Text="便笺" FontSize="22" FontWeight="Bold" Margin="11,0,0,0" VerticalAlignment="Center"/>
            <Grid x:Name="NotesPage" Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#EFEFEF" Margin="11,3,11,5">
                <Grid>
                    <TextBox x:Name="SearchBox" Margin="11,0,34,0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="13" TextChanged="SearchChanged"/>
                    <TextBlock x:Name="SearchHint" Text="搜索…" Margin="11,0,0,0" Foreground="#777777" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#777777" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="11,7,11,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <ResourceDictionary Source="/Stick It;component/Assets/ScrollBarStyles.xaml"/>
                    </ScrollViewer.Resources>
                    <ItemsControl x:Name="NoteList" HorizontalContentAlignment="Stretch">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Background="{Binding Background}" BorderThickness="0" Padding="0" Margin="0,0,0,8" HorizontalContentAlignment="Stretch" Click="OpenCard" Tag="{Binding Note}">
                                <Button.ContextMenu><ContextMenu><MenuItem Header="删除便签" Click="DeleteCard"/></ContextMenu></Button.ContextMenu>
                                <Button.Template><ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="2"><ContentPresenter/></Border>
                                </ControlTemplate></Button.Template>
                                <Grid MinHeight="58">
                                    <FlowDocumentScrollViewer Document="{Binding Preview}" Margin="15,23,15,15"
                                                              MaxHeight="120" VerticalAlignment="Top"
                                                              IsToolBarVisible="False" IsHitTestVisible="False" Focusable="False"
                                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                                                              Background="Transparent" BorderThickness="0" Padding="0"/>
                                    <TextBlock Text="{Binding Time}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,9,0" FontSize="9" Foreground="#555555"/>
                                    <Polygon Points="0,14 0,0 14,0" Width="14" Height="14" Fill="#18000000" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" Margin="20,64,20,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" Text="还没有便签" FontSize="17" HorizontalAlignment="Center" Foreground="#777777"/>
                    <TextBlock Text="按 Shift + Alt + W 随手记一笔" Margin="0,10,0,0" FontSize="12" Foreground="#999999"/>
                </StackPanel>
            </Grid>
            </Grid>
            <ScrollViewer x:Name="SettingsPage" Grid.Row="2" Visibility="Collapsed" Margin="15,8,15,12"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ScrollViewer.Resources><ResourceDictionary Source="/Stick It;component/Assets/ScrollBarStyles.xaml"/></ScrollViewer.Resources>
                <StackPanel Margin="0,0,4,0">
                    <TextBlock Text="常规" Style="{StaticResource SettingsHeading}" Margin="2,6,0,9"/>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <CheckBox x:Name="RandomNoteColor" Style="{StaticResource SettingsSwitch}" Click="RandomNoteColorClick" AutomationProperties.Name="新建便签随机颜色">
                                <StackPanel>
                                    <TextBlock Text="新建便签随机颜色" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="每次新建时，随机选择一种便签配色。" FontSize="12" Foreground="#767676" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="#EAEAEA" Margin="15,0"/>
                            <CheckBox x:Name="AutoMouseMode" Style="{StaticResource SettingsSwitch}" IsChecked="True" Click="MouseModeClick" AutomationProperties.Name="游戏鼠标自动穿透">
                                <StackPanel>
                                    <TextBlock Text="游戏鼠标自动穿透" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="游戏隐藏并锁定鼠标时，让操作穿过便签。" FontSize="12" Foreground="#767676" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="快捷操作" Style="{StaticResource SettingsHeading}"/>
                    <Border Style="{StaticResource SettingsCard}" Padding="15">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="新建便签" FontSize="13" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="White" BorderBrush="#E2E2E2" BorderThickness="1" CornerRadius="5" Padding="9,5">
                                    <TextBlock Text="Shift + Alt + W" FontSize="12" Foreground="#525252"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="点击便签正文即可编辑，支持 Markdown 和底部格式工具。" FontSize="12" Foreground="#767676" TextWrapping="Wrap" Margin="0,13,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="应用" Style="{StaticResource SettingsHeading}"/>
                    <TextBlock Text="便签内容会自动保存。" FontSize="12" Foreground="#767676" Margin="2,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="SaveButton" Style="{StaticResource SettingsAction}" Content="立即保存" Click="SaveClick"/>
                        <Button x:Name="ExitButton" Grid.Column="2" Style="{StaticResource SettingsAction}" Content="保存并退出" Click="ExitClick"/>
                    </Grid>
                    <TextBlock Text="关闭窗口会收起到托盘，便签继续保留。" FontSize="12" Foreground="#8A8A8A" Margin="2,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="StatusText" Grid.Row="3" Margin="12,0,12,9" TextWrapping="Wrap" Foreground="#A74629" FontSize="12" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
